# Database.
# Optional for local work: `npm run db:seed` falls back to `file:./prisma/dev.db`, and the
# test suite always uses its own throwaway file under the OS temp directory.
# The Prisma CLI reads this file directly; `tsx` does not.
DATABASE_URL="file:./dev.db"

# Optional: For production PostgreSQL
# DATABASE_URL="postgresql://username:password@localhost:5432/localtime?schema=public"

# Optional: For production MySQL
# DATABASE_URL="mysql://username:password@localhost:3306/localtime"
