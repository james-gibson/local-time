{
  "name": "local-time-system",
  "version": "0.0.2",
  "description": "James' Temporal universe system for tracking time across fictional and real works",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "jest",
    "test:scripts": "node --test \"scripts/__tests__/*.test.js\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "timeline": "tsx scripts/timeline-visualizer.ts",
    "timeline:watch": "tsx watch scripts/timeline-visualizer.ts",
    "atlas:sync": "node scripts/atlas-sync.mjs"
  },
  "keywords": [
    "james",
    "temporal",
    "universe",
    "time",
    "fiction",
    "narrative"
  ],
  "author": "Local Time System",
  "license": "",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "ksuid": "^3.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": ">=22",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^8.57.1",
    "jest": "^30.5.2",
    "prisma": "^5.7.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  },
  "files": [
    "dist/**/*",
    "prisma/schema.prisma"
  ]
}
